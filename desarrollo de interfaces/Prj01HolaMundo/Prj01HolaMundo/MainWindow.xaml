<Window x:Class="Prj01HolaMundo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prj01HolaMundo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <TextBlock
            Text="Hola Mundo"
            FontSize="70"
            FontFamily="Engravers MT"
            FontStyle="Italic"
            FontWeight="ExtraBold"
            Foreground="Pink"
            Width="800"
            Height="100"
            VerticalAlignment="Top"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            />

        <TextBox x:Name="txtMensaje"
            Width="800"
            Height="100"
            VerticalAlignment="Center"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            Background="LightPink"
            FontSize="70"
            FontFamily="Engravers MT"
            FontStyle="Oblique"
            FontWeight="ExtraLight" TextChanged="txtMensaje_TextChanged"
            />

        <Button
            Width="300"
            Height="100"
            VerticalAlignment="Bottom"
            Margin="0 0 0 30"
            Content="Pulsar"
            TextBlock.FontFamily="Franklin Gothic Medium"
            TextBlock.FontSize="60"
            TextBlock.Foreground="Red"
            Click="Button_Click"
            />


    </Grid>
</Window>
