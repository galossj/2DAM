<Window x:Class="Prj02Calculadora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculadora"
        Height="600"
        Width="350"
        MinHeight="500"
        MinWidth="300"
        Background="#101010"
        WindowStartupLocation="CenterScreen">

    <!-- ========================================================= -->
    <!-- RECURSOS Y ESTILOS                                        -->
    <!-- ========================================================= -->

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- ESTILO BASE DE LOS BOTONES                            -->
        <!-- Se utiliza para los botones numéricos.                -->
        <!-- ===================================================== -->

        <Style x:Key="CalculatorButton"
               TargetType="Button">

            <!-- Color normal -->
            <Setter Property="Background" Value="#333333"/>

            <!-- Color del texto -->
            <Setter Property="Foreground" Value="White"/>

            <!-- Tamaño del texto -->
            <Setter Property="FontSize" Value="30"/>

            <!-- Grosor del texto -->
            <Setter Property="FontWeight" Value="Normal"/>

            <!-- Quitamos el borde por defecto -->
            <Setter Property="BorderThickness" Value="0"/>

            <!-- Separación entre botones -->
            <Setter Property="Margin" Value="5"/>

            <!-- Cursor de mano -->
            <Setter Property="Cursor" Value="Hand"/>


            <!-- ================================================= -->
            <!-- PLANTILLA PERSONALIZADA DEL BOTÓN                -->
            <!-- ================================================= -->

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="50"
                                RenderTransformOrigin="0.5,0.5">

                            <!-- ================================= -->
                            <!-- TRANSFORMACIÓN PARA LA ANIMACIÓN -->
                            <!-- ================================= -->

                            <Border.RenderTransform>

                                <ScaleTransform
                                    ScaleX="1"
                                    ScaleY="1"/>

                            </Border.RenderTransform>


                            <!-- Contenido del botón -->
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <!-- ================================================= -->
                        <!-- ESTADOS Y ANIMACIONES                              -->
                        <!-- ================================================= -->

                        <ControlTemplate.Triggers>


                            <!-- ============================================= -->
                            <!-- AL PASAR EL RATÓN                             -->
                            <!-- ============================================= -->

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#555555"/>

                            </Trigger>


                            <!-- ============================================= -->
                            <!-- AL PULSAR EL BOTÓN                           -->
                            <!-- ============================================= -->

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <!-- Cambiamos el color -->
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#777777"/>


                                <!-- ========================================= -->
                                <!-- ANIMACIÓN AL PULSAR                       -->
                                <!-- El botón se hace un 82% de su tamaño.    -->
                                <!-- ========================================= -->

                                <Trigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonBorder"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="0.82"
                                                Duration="0:0:0.08"/>

                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonBorder"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="0.82"
                                                Duration="0:0:0.08"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.EnterActions>


                                <!-- ========================================= -->
                                <!-- ANIMACIÓN AL SOLTAR                       -->
                                <!-- El botón vuelve suavemente a su tamaño.   -->
                                <!-- ========================================= -->

                                <Trigger.ExitActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonBorder"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1"
                                                Duration="0:0:0.08"/>

                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonBorder"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1"
                                                Duration="0:0:0.08"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.ExitActions>

                            </Trigger>


                            <!-- ============================================= -->
                            <!-- BOTÓN DESACTIVADO                            -->
                            <!-- ============================================= -->

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- ESTILO PARA LOS OPERADORES                            -->
        <!-- +  -  X  ÷                                            -->
        <!-- ===================================================== -->

        <Style x:Key="OperatorButton"
               TargetType="Button"
               BasedOn="{StaticResource CalculatorButton}">

            <Setter Property="Background"
                    Value="#FF9500"/>

            <Style.Triggers>

                <!-- Hover -->
                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FFB340"/>

                </Trigger>

                <!-- Pulsado -->
                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#CC7600"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- ESTILO DEL BOTÓN C                                    -->
        <!-- ===================================================== -->

        <Style x:Key="ClearButton"
               TargetType="Button"
               BasedOn="{StaticResource CalculatorButton}">

            <Setter Property="Background"
                    Value="#A5A5A5"/>

            <Setter Property="Foreground"
                    Value="#101010"/>

            <Style.Triggers>

                <!-- Hover -->
                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#C7C7C7"/>

                </Trigger>

                <!-- Pulsado -->
                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#858585"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- GRID PRINCIPAL                                             -->
    <!--                                                             -->
    <!-- Fila 0 -> Título                                           -->
    <!-- Fila 1 -> Pantalla                                         -->
    <!-- Fila 2 -> Botones                                          -->
    <!-- ========================================================= -->

    <Grid Margin="10">

        <Grid.RowDefinitions>

            <!-- Título -->
            <RowDefinition Height="50"/>

            <!-- Pantalla -->
            <RowDefinition Height="100"/>

            <!-- Botones -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- TÍTULO                                                  -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0">

            <Label Content="CALCULADORA"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#AAAAAA"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>

        </Grid>


        <!-- ===================================================== -->
        <!-- PANTALLA DE RESULTADOS                                  -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              Margin="0,3,0,5">

            <!-- Fondo de la pantalla -->
            <Border Background="#1C1C1E"
                    CornerRadius="18"
                    Padding="12,6">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- Operación -->
                        <RowDefinition Height="28"/>

                        <!-- Resultado -->
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- OPERACIÓN ACTUAL                                 -->
                    <!-- Ejemplo: 25 +                                      -->
                    <!-- ================================================= -->

                    <TextBlock x:Name="txtOperation"
                               Grid.Row="0"
                               Text=""
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#8E8E93"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>


                    <!-- ================================================= -->
                    <!-- RESULTADO                                          -->
                    <!-- ================================================= -->

                    <TextBox x:Name="txtResult"
                             Grid.Row="1"
                             Text="0"
                             FontSize="44"
                             FontWeight="SemiBold"
                             Foreground="#FFFFFF"
                             Background="Transparent"
                             BorderThickness="0"
                             TextAlignment="Right"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Right"
                             IsReadOnly="True"
                             IsTabStop="False"
                             Focusable="False"
                             Padding="0"
                             CaretBrush="Transparent"
                             SelectionBrush="Transparent"
                             TextWrapping="NoWrap"/>

                </Grid>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- ZONA DE LOS BOTONES                                     -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2">


            <!-- ================================================= -->
            <!-- FILAS                                               -->
            <!-- ================================================= -->

            <Grid.RowDefinitions>

                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- COLUMNAS                                           -->
            <!-- ================================================= -->

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- FILA 1                                              -->
            <!-- 7 | 8 | 9 | ÷                                     -->
            <!-- ================================================= -->

            <Button x:Name="Btt_7"
                    Grid.Row="0"
                    Grid.Column="0"
                    Content="7"
                    Style="{StaticResource CalculatorButton}"/>

            <Button x:Name="Btt_8"
                    Grid.Row="0"
                    Grid.Column="1"
                    Content="8"
                    Style="{StaticResource CalculatorButton}"/>

            <Button x:Name="Btt_9"
                    Grid.Row="0"
                    Grid.Column="2"
                    Content="9"
                    Style="{StaticResource CalculatorButton}"/>

            <Button x:Name="Btt_Div"
                    Grid.Row="0"
                    Grid.Column="3"
                    Content="÷"
                    Style="{StaticResource OperatorButton}"/>


            <!-- ================================================= -->
            <!-- FILA 2                                              -->
            <!-- 4 | 5 | 6 | X                                     -->
            <!-- ================================================= -->

            <Button x:Name="Btt_4"
                    Grid.Row="1"
                    Grid.Column="0"
                    Content="4"
                    Style="{StaticResource CalculatorButton}"/>

            <Button x:Name="Btt_5"
                    Grid.Row="1"
                    Grid.Column="1"
                    Content="5"
                    Style="{StaticResource CalculatorButton}"/>

            <Button x:Name="Btt_6"
                    Grid.Row="1"
                    Grid.Column="2"
                    Content="6"
                    Style="{StaticResource CalculatorButton}"/>

            <!-- IMPORTANTE: debe ser X porque el C# busca X -->
            <Button x:Name="Btt_Mult"
                    Grid.Row="1"
                    Grid.Column="3"
                    Content="X"
                    Style="{StaticResource OperatorButton}"/>


            <!-- ================================================= -->
            <!-- FILA 3                                              -->
            <!-- 1 | 2 | 3 | -                                     -->
            <!-- ================================================= -->

            <Button x:Name="Btt_1"
                    Grid.Row="2"
                    Grid.Column="0"
                    Content="1"
                    Style="{StaticResource CalculatorButton}"/>

            <Button x:Name="Btt_2"
                    Grid.Row="2"
                    Grid.Column="1"
                    Content="2"
                    Style="{StaticResource CalculatorButton}"/>

            <Button x:Name="Btt_3"
                    Grid.Row="2"
                    Grid.Column="2"
                    Content="3"
                    Style="{StaticResource CalculatorButton}"/>

            <!-- IMPORTANTE: debe ser - porque el C# busca - -->
            <Button x:Name="Btt_Resta"
                    Grid.Row="2"
                    Grid.Column="3"
                    Content="-"
                    Style="{StaticResource OperatorButton}"/>


            <!-- ================================================= -->
            <!-- FILA 4                                              -->
            <!-- 0 | , | = | +                                     -->
            <!-- ================================================= -->

            <Button x:Name="Btt_0"
                    Grid.Row="3"
                    Grid.Column="0"
                    Content="0"
                    Style="{StaticResource CalculatorButton}"/>

            <Button x:Name="Btt_Coma"
                    Grid.Row="3"
                    Grid.Column="1"
                    Content=","
                    Style="{StaticResource CalculatorButton}"/>

            <Button x:Name="Btt_Igual"
                    Grid.Row="3"
                    Grid.Column="2"
                    Content="="
                    Style="{StaticResource CalculatorButton}"/>

            <Button x:Name="Btt_Suma"
                    Grid.Row="3"
                    Grid.Column="3"
                    Content="+"
                    Style="{StaticResource OperatorButton}"/>


            <!-- ================================================= -->
            <!-- FILA 5                                              -->
            <!-- BOTÓN C                                             -->
            <!-- ================================================= -->

            <Button x:Name="Btt_Delete"
                    Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Content="C"
                    Style="{StaticResource ClearButton}"/>

        </Grid>

    </Grid>

</Window>