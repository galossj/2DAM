<Window x:Class="JoyFit.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JoyFit.Desktop"
        Title="JoyFit" 
        Height="700" 
        Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#15151F">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!--Menu lateral-->
        <StackPanel Grid.Column="0"
                    Background="#211F35">

            <TextBlock Text="JOYFIT"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#A78BFA"
                       HorizontalAlignment="Center"
                       Margin="0,30,0,40"/>
            
            <Button Content="Inicio"
                    Height="45"
                    Margin="15,5"
                    Click="Inicio_Click"/>

            <Button Content="Clientes"
                    Height="45"
                    Margin="15,5"
                    Click="Clientes_Click"/>

            <Button Content="Suscripciones"
                    Height="45"
                    Margin="15,5"
                    Click="Suscripciones_Click"/>

            <Button Content="Rutinas"
                    Height="45"
                    Margin="15,5"
                    Click="Rutinas_Click"/>

            <Button Content="Tienda"
                    Height="45"
                    Margin="15,5"
                    Click="Tienda_Click"/>
            
        </StackPanel>
        
        <!--Contenido principal-->
        <Grid Grid.Column="1"
              Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Panel de administración"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Frame x:Name="MainFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"/>

        </Grid>
    </Grid>
</Window>
