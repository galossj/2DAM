<Page x:Class="JoyFit.Desktop.Pages.InicioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:JoyFit.Desktop.Pages"
      Title="InicioPage">

    <Grid Background="#15151F" Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--Bienvenida-->
        <StackPanel Margin="15">
            <TextBlock Text="¡Bienvenido a JoyFit!"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Panel de administración"
                       Foreground="#A78BFA"
                       FontSize="14"
                       Margin="0,8,0,0"/>
        </StackPanel>
        
        <!--Estadísticas-->
        <UniformGrid Grid.Row="1" Columns="3"
                     Margin="10">

            <Border Background="#211F35"
                    CornerRadius="12"
                    Margin="5" Padding="15">
                
                <StackPanel VerticalAlignment="Center">
                    
                    <TextBlock Text="Clientes"
                               Foreground="#A78BFA"
                               FontSize="16"/>
                    
                    <TextBlock Text="125"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>
                    
                </StackPanel>
                
            </Border>

            <Border Background="#211F35"
                    CornerRadius="12"
                    Margin="5" Padding="15">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Suscripciones activas"
                               Foreground="#A78BFA"
                               FontSize="16"/>

                    <TextBlock Text="98"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>
                    
                </StackPanel>
                
            </Border>
            
            
        </UniformGrid>
        
        <!--Actividad reciente-->
        <Border Grid.Row="2"
                Background="#211F35"
                CornerRadius="12"
                Margin="15"
                Padding="20">

            <StackPanel>

                <TextBlock Text="Actividad reciente"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock Text="Todavía no hay actividad registrada."
                           Foreground="#AAAAAA"
                           Margin="0,20,0,0"/>
                
            </StackPanel>
            
        </Border>
        
    </Grid>
    
</Page>
