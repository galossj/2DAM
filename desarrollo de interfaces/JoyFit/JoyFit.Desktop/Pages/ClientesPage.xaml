<Page x:Class="JoyFit.Desktop.Pages.ClientesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:JoyFit.Desktop.Pages"
      Title="ClientesPage">

    <Grid Background="#15151F" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--Titulo-->
        <TextBlock Text="Gestión de clientes"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   VerticalAlignment="Center"/>
        
        <!--Buscador y botón-->
        <Grid Grid.Row="1" Margin="0,5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtBuscar"
                     Height="35"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     Margin="0,0,15,0"
                     ToolTip="Buscar cliente"
                     TextChanged="TxtBuscar_TextChanged"/>

            <Button Grid.Column="1"
                    Content="+ Añadir cliente"
                    Background="#8B5CF6"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Height="35"
                    Click="AñadirCliente_Click"/>

            <Button Grid.Column="2"
                    Content="Editar cliente"
                    Background="#8B5CF6"
                    Foreground="White"
                    FontWeight="Bold"
                    Width="130"
                    Height="35"
                    Margin="5"
                    Click="EditarCliente_Click"/>

            <Button Grid.Column= "3"
                    Content= "Eliminar cliente"
                    Background="#8B5CF6"
                    Foreground="White"
                    FontWeight="Bold"
                    Width="140"
                    Height="35"
                    Margin="5"
                    Click="EliminarCliente_Click"/>

        </Grid>
        
        <!--Tabla-->
        <DataGrid x:Name="DataGridClientes"
                  Grid.Row="2"
                  Margin="0,15,0,0"
                  Background="#211F35"
                  Foreground="BlueViolet"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Nombre"
                                    Binding="{Binding Nombre}"
                                    Width="*"/>

                <DataGridTextColumn Header="Apellidos"
                                    Binding="{Binding Apellidos}"
                                    Width="*"/>

                <DataGridTextColumn Header="DNI"
                                    Binding="{Binding DNI}"
                                    Width="*"/>

                <DataGridTextColumn Header="Teléfono"
                                    Binding="{Binding Telefono}"
                                    Width="*"/>

                <DataGridTextColumn Header="Correo"
                                    Binding="{Binding Correo}"
                                    Width="*"/>
                
            </DataGrid.Columns>
            
        </DataGrid>
        
    </Grid>
    
</Page>
